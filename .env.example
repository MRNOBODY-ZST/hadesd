# pnpm setup writes .env and a private administrator password file; never commit them.
DB_HOST=127.0.0.1
DB_PORT=23306
DB_NAME=hadesd
DB_USERNAME=hadesd
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=26379
REDIS_PASSWORD=
SERVER_PORT=28080
API_ORIGIN=http://127.0.0.1:28080
LOCAL_PORT=18088
WORKER_TOKEN=
# Absolute paths are generated by setup; containers override these.
RELEASE_ROOT=
MEDIA_ROOT=
ADMIN_BOOTSTRAP_USERNAME=hades
ADMIN_BOOTSTRAP_PASSWORD_FILE=
SESSION_SECURE=false
STORAGE_MODE=local
# Optional private S3-compatible storage; use compose.s3.yaml for backend egress.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PATH_STYLE=false
# Leave empty when using an IAM role/default credential provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SITE_ORIGIN=https://hadesd.sh
WORKER_POLL_MS=3000
