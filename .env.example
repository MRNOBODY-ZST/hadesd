# pnpm setup writes .env and a private administrator password file; never commit them.
DB_HOST=127.0.0.1
DB_PORT=23306
DB_NAME=hadesd
DB_USERNAME=hadesd
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=26379
REDIS_PASSWORD=
SERVER_PORT=28080
API_ORIGIN=http://127.0.0.1:28080
LOCAL_PORT=18088
# Docker standalone only: comma-separated trusted reverse proxy IPs/CIDRs.
# Empty by default: incoming X-Forwarded-For is not trusted. Rebuild nginx after changes.
# TRUSTED_PROXY_CIDRS=
WORKER_TOKEN=
# Absolute paths are generated by setup; containers override these.
RELEASE_ROOT=
MEDIA_ROOT=
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD_FILE=
SESSION_SECURE=false
STORAGE_MODE=local
# MinIO: run node scripts/setup-minio.mjs and use compose.minio.yaml.
# Migrate existing files before changing STORAGE_MODE to s3; see docs/minio.md.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=19000
# Private MinIO uses compose.minio.yaml; an external S3 endpoint uses compose.s3.yaml.
# setup-minio fills blank bucket/endpoint values but preserves nonempty settings.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
# MinIO requires true. For native AWS S3, use false and clear S3_ENDPOINT.
S3_PATH_STYLE=true
# Leave empty when using an IAM role/default credential provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional transfer/export settings (use absolute host or container paths).
# STORAGE_SOURCE_ROOT defaults to MEDIA_ROOT. A local export requires STORAGE_TARGET_ROOT.
# STORAGE_SOURCE_ROOT=
# STORAGE_TARGET_ROOT=
# STORAGE_TRANSFER_REPORT=
# Public origin only: no subpath, query, credentials or fragment.
SITE_ORIGIN=http://localhost:18088
WORKER_POLL_MS=3000
